# Copy to .env.local for local Compose only. Never commit real secrets.
POSTGRES_DB=sangsok
POSTGRES_USER=sangsok
POSTGRES_PASSWORD=replace-with-a-local-password
WEB_PORT=5173
# 개발 중에는 mock 권장. 요금이 발생하지 않고 문서 분석 흐름은 그대로 동작한다.
AI_PROVIDER=mock
AI_API_KEY=replace-with-a-secret-from-your-deployment-platform
# 기본은 gpt-4o. 개발 중 요금을 줄이려면 gpt-4.1-nano 또는 gpt-4.1-mini로 바꾼다.
AI_MODEL=gpt-4o
AI_BASE_URL=https://api.openai.com/v1
JWT_SECRET=replace-with-at-least-32-random-characters
# local = 서버 디스크(개발용), s3 = AWS S3 버킷(운영). s3일 때만 아래 두 값을 사용한다.
STORAGE_TYPE=local
STORAGE_PATH=./data/uploads
S3_BUCKET=
AWS_REGION=ap-northeast-2
